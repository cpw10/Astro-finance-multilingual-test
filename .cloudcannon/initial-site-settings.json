{
  "ssg": "astro",
  "mode": "hosted",
  "build": {
    "install_command": "npm ci",
    "build_command": "npm run build",
    "output_path": "dist",
    "node_version": "file",
    "preserved_paths": "node_modules/",
    "environment_variables": [
      {
        "key": "CLOUDCANNON_SYNC_PATHS",
        "value": "/rosey/"
      }
    ]
  }
}
