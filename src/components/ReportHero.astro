---
import Button from './Button.astro'
import site from '@/data/site.json'
import { imageUrl } from '@/lib/images'
import { formatReportDate } from '@/lib/reports'

// The report page wraps this in an <editable-component> that passes these four fields,
// so the date and the background image update while editing.
const { title, author, published_date, image } = Astro.props
const background = await imageUrl(image?.src)
// The three labels are the same on every report, so their translation keys leave the page's
// namespace (`report_labels:*`). The title keeps it (`report/<slug>:title`).
const labelsRoot = 'report_labels'
---

<div
  class="min-h-[44vh] flex flex-col justify-center items-center text-white"
  style={`background: linear-gradient(0deg, rgba(0, 0, 0, 0.70) 0%, rgba(0, 0, 0, 0.70) 100%) ${background ? `, url('${background}') center/cover no-repeat lightgray` : ''}`}
>
  <div class="container mx-auto px-6">
    <div class="max-w-[624px] mx-auto flex flex-col justify-center items-center pt-28 pb-14">
      <span class="block text-center opacity-65 leading-[24px] mb-3" data-editable="text" data-prop="@data[site].report.label" data-rosey-root={labelsRoot} data-rosey="label">{site.report.label}</span>
      <h1 class="text-3xl md:text-5xl leading-[120%] text-center font-heading" data-editable="text" data-prop="title" data-rosey="title">{title}</h1>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 my-8">
        <div class="font-medium"><span data-editable="text" data-prop="@data[site].report.author_label" data-rosey-root={labelsRoot} data-rosey="author_label">{site.report.author_label}</span>: <span data-editable="text" data-prop="author">{author}</span></div>
        <span class="w-[5px] h-[5px] bg-white opacity-50 rounded-[0.5px]"></span>
        <div class="font-medium">{published_date && formatReportDate(published_date)}</div>
      </div>

      <Button label={site.report.back_label} href="/report/" labelProp="@data[site].report.back_label" roseyRoot={labelsRoot} data-rosey="back_label" />
    </div>
  </div>
</div>
