---
import { Button } from '@/components/ui/button'
import { HamburgerMenu, HamburgerMenuItem } from '@/components/ui/hamburger-menu'
import LanguageSwitcher from './LanguageSwitcher.astro'
import site from '@/data/site.json'
import { roseyTextKey } from '@/lib/rosey'

// Props are the keys of src/data/navigation.json: Layout.astro spreads the file in, and
// CloudCannon's Visual Editor passes the edited file the same way when it re-renders the header.
const { cta } = Astro.props
// `pathname` comes from Layout.astro at build time. It is missing when the Visual Editor
// re-renders the header, and the language switcher is left out there (the editor has its own).
const { pathname } = Astro.props
const items = Astro.props.items ?? []
const glassButton = 'button--glass h-auto rounded-sm bg-black/20 font-normal text-white backdrop-blur-sm hover:bg-black/20 hover:text-white'
const hamburgerLine = 'block h-0.5 w-full bg-white duration-300'
// Translation keys (Rosey): `nav:<label as a slug>` for links, shared with the mobile menu and the
// footer navigation, and `nav:cta_label` for the button.
---

<header class="absolute top-0 right-0 left-0 border-b border-border z-50" id="header" data-rosey-ns="nav">
  <HamburgerMenu
    class="bg-transparent"
    triggerLabel="Toggle Navigation"
    barClass="relative z-[60] mx-auto h-auto max-w-[1016px] justify-between gap-4 border-b-0 px-6 py-6 md:grid md:grid-cols-3 md:gap-0 md:[&>[data-slot=hamburger-menu-actions]]:contents"
    triggerClass="h-5 w-6 flex-col items-stretch justify-between rounded-none hover:bg-transparent md:hidden"
    panelClass="fixed inset-0 h-auto bg-primary p-0 text-2xl text-white shadow-none transition-transform duration-300 data-[ending-style]:translate-x-full data-[starting-style]:translate-x-full data-[starting-style]:transition-none md:hidden [&>nav]:justify-center [&_[data-slot=hamburger-menu-items]]:items-center [&_[data-slot=hamburger-menu-items]]:gap-8"
  >
    <!-- Logo -->
    <a slot="brand" class="block" href="/">
      {site.logo?.src && <img src={site.logo.src} alt={site.logo.alt ?? ''} data-editable="image" data-prop="@data[site].logo" />}
    </a>

    <!-- Desktop navigation -->
    <nav slot="actions" class="hidden md:block">
      <ul
        class="flex items-center justify-center text-[0.81rem] leading-[calc(2/1.5)] text-white"
        data-editable="array"
        data-prop="items"
      >
        {items.map((item) => (
          <li data-editable="array-item">
            <a href={item.url || '#'} class="block px-4 py-2 capitalize hover:opacity-80">
              <span data-editable="text" data-prop="label" data-rosey={roseyTextKey(item.label)}>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right side -->
    <div slot="actions" class="flex items-center gap-4 md:justify-self-end">
      {pathname && <LanguageSwitcher pathname={pathname} />}
      {cta?.label?.trim() && (
        <Button
          as="a"
          href={cta.url || '#'}
          variant="ghost"
          class:list={[glassButton, 'hidden px-3 py-1.5 text-sm md:inline-flex']}
        >
          <span data-editable="text" data-prop="cta.label" data-rosey="cta_label">{cta.label}</span>
        </Button>
      )}
    </div>

    <!-- Hamburger icon -->
    <Fragment slot="trigger">
      <span class:list={[hamburgerLine, 'transition-transform group-data-[state=open]/hamburger-menu:translate-y-[9px] group-data-[state=open]/hamburger-menu:rotate-45']}></span>
      <span class:list={[hamburgerLine, 'transition-opacity group-data-[state=open]/hamburger-menu:opacity-0']}></span>
      <span class:list={[hamburgerLine, 'transition-transform group-data-[state=open]/hamburger-menu:-translate-y-[9px] group-data-[state=open]/hamburger-menu:-rotate-45']}></span>
    </Fragment>

    <!-- Mobile navigation: a second copy of the links and the button, kept in step by the header re-render -->
    {items.map((item) => (
      <HamburgerMenuItem
        href={item.url || '#'}
        class="rounded-none px-4 py-2 text-2xl font-normal text-white capitalize hover:text-white hover:opacity-80"
      >
        <span data-rosey={roseyTextKey(item.label)}>{item.label}</span>
      </HamburgerMenuItem>
    ))}

    <!-- Mobile CTA at bottom -->
    <div>
      {cta?.label?.trim() && (
        <Button
          as="a"
          href={cta.url || '#'}
          variant="ghost"
          class:list={[glassButton, 'inline px-6 py-3 text-lg']}
        >
          <span data-rosey="cta_label">{cta.label}</span>
        </Button>
      )}
    </div>
  </HamburgerMenu>
</header>
