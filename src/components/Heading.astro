---
import { Badge } from '@/components/ui/badge'
import { plainBadge } from '@/lib/ui'

// Every block stores this badge under `heading`, so the editable paths are fixed.
const { title, icon, variant } = Astro.props

const variants = {
  default: 'border-0 p-0',
  glass: 'p-2 bg-black/30 backdrop-blur border-transparent text-white [border-image:linear-gradient(to_right,#ffffff14,#ffffff17)_1]',
}
---

<Badge as="h2" variant="outline" class:list={[plainBadge, variants[variant] || variants.default]}>
  <div class="bg-primary p-1 rounded-sm">
    {icon && <img src={icon} alt="" class="w-[25px] h-[25px]" data-editable="image" data-prop-src="heading.icon" />}
  </div>
  <span data-editable="text" data-prop="heading.title" data-rosey="heading_title">{title}</span>
</Badge>
