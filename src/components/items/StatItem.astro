---
import { Card } from '@/components/ui/card'
import { flatCard } from '@/lib/ui'

// One card of the stats block. Rendered on its own so the Visual Editor can re-render a single item.
// `_uuid` namespaces this item's Rosey translation keys, so they survive a reorder.
const { _uuid, number, label, primary } = Astro.props
---

<Card data-rosey-ns={_uuid} class:list={[flatCard, 'h-full p-8', primary === true && 'bg-primary text-primary-foreground']}>
  <span class="block text-5xl md:text-4xl lg:text-5xl font-heading capitalize mb-20 md:mb-36" data-editable="text" data-prop="number" data-rosey="number">{number}</span>
  <h3 class="opacity-65" data-editable="text" data-prop="label" data-rosey="label">{label}</h3>
</Card>
