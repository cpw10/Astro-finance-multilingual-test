---
import { Image } from 'astro:assets'
import ArrowLink from '@/components/ArrowLink.astro'
import { resolveImage } from '@/lib/images'

// One person of the team block. Rendered on its own so the Visual Editor can re-render a single item.
// `_uuid` namespaces this item's Rosey translation keys, so they survive a reorder.
const { _uuid, image, name, role, link } = Astro.props
const imageSrc = resolveImage(image?.src)
---

{imageSrc && (
  <Image
    class="block w-full"
    src={imageSrc}
    alt={image?.alt ?? ''}
    width={539}
    height={315}
    layout="full-width"
    loading="lazy"
    data-editable="image"
    data-prop="image"
  />
)}
<div class="flex items-center justify-between gap-2 mt-4 text-black" data-rosey-ns={_uuid}>
  <h3 class="text-2xl" data-editable="text" data-prop="name">{name}</h3>
  <span class="text-sm" data-editable="text" data-prop="role" data-rosey="role">{role}</span>
</div>
<ArrowLink reveal href={link || '#'} class="-top-[8px] right-[24px]" />
