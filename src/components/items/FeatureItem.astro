---
import { Image } from 'astro:assets'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { flatCard } from '@/lib/ui'
import { resolveImage } from '@/lib/images'

// One card of the features block. Rendered on its own so the Visual Editor can re-render a single item.
// `_uuid` namespaces this item's Rosey translation keys, so they survive a reorder.
const { _uuid, title, image, description } = Astro.props
const imageSrc = resolveImage(image?.src)
---

<Card data-rosey-ns={_uuid} class:list={[flatCard, 'h-full']}>
  <CardHeader class="gap-0 rounded-none p-6">
    <CardTitle class="text-xl font-normal text-wrap capitalize">
      <h3 data-editable="text" data-prop="title" data-rosey="title">{title}</h3>
    </CardTitle>
  </CardHeader>
  {imageSrc && (
    <Image
      src={imageSrc}
      alt={image?.alt ?? ''}
      width={350}
      height={242}
      layout="full-width"
      loading="lazy"
      data-editable="image"
      data-prop="image"
    />
  )}
  <CardContent class="p-6">
    <p class="opacity-65" data-editable="text" data-prop="description" data-rosey="description">{description}</p>
  </CardContent>
</Card>
