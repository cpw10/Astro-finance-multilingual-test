---
import TeamMemberItem from '@/components/items/TeamMemberItem.astro'

const { _uuid, title, members } = Astro.props
---

<section data-rosey-ns={_uuid}>
  <div class="container mx-auto px-6">
    {title && <h2 class="text-3xl md:text-5xl text-center font-heading mb-16 px-6" data-editable="text" data-prop="title" data-rosey="title">{title}</h2>}

    <ul
      class="grid md:grid-cols-2 gap-y-16 gap-x-5"
      data-editable="array"
      data-prop="members"
      data-component="team_member_item"
      data-direction="row"
    >
      {members?.map((member) => (
        <li class="relative group" data-editable="array-item" data-component="team_member_item">
          <TeamMemberItem {...member} />
        </li>
      ))}
    </ul>
  </div>
</section>
